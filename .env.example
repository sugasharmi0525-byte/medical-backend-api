# -----------------------------------------------------------------------------
# Backend environment file. Copy to ".env" for local (non-docker) development.
# In Docker Compose, values come from the root ".env" file instead.
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True


# Database: MySQL 8 (current). Load MySQL's time zone tables once - see docs/database-mysql.md.
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medicine
DB_USER=root
DB_PASSWORD=change-me
# PostgreSQL alternative:
# DB_TYPE=postgresql
# DB_PORT=5432
# DB_USER=postgres

REDIS_URL=redis://localhost:6379/0

ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Uncomment if Redis is not running locally
# CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# -----------------------------------------------------------------------------
# Patient messaging (email + WhatsApp). See the "Email & WhatsApp" screen
# (Super Admin) for live status, templates, delivery log and test sends.
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
SITE_NAME=Medicine Neuro Life
# sync | thread (default, no Redis needed) | celery (production with Redis)
NOTIFICATIONS_DELIVERY=thread
# Demo/test domains that are never contacted
NOTIFICATIONS_SKIP_DOMAINS=medicine.demo,example.demo,test.demo
REMINDER_HOURS_BEFORE=24

# Email. Leave EMAIL_BACKEND unset to save emails as files in backend/tmp/sent_emails/
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@yourdomain.com
# EMAIL_HOST_PASSWORD=<app password>
# DEFAULT_FROM_EMAIL=Medicine Neuro Life <you@yourdomain.com>

# WhatsApp: console (log only) | meta (WhatsApp Business Cloud API)
WHATSAPP_PROVIDER=console
# WHATSAPP_ACCESS_TOKEN=<permanent system-user token>
# WHATSAPP_PHONE_NUMBER_ID=<phone number id>
# WHATSAPP_API_VERSION=v20.0
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Sandbox: only these numbers receive WhatsApp (digits incl. country code)
# WHATSAPP_TEST_RECIPIENTS=919876543210
